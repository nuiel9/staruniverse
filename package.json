{
  "name": "star-universe",
  "version": "0.1.0",
  "description": "STAR UNIVERSE — a procedural space trading & exploration game in WebGL2, based on The Long Silence by Anshu Chimala",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "verify": "node tools/verify.mjs",
    "fieldcheck": "node tools/fieldcheck.mjs",
    "treecheck": "node tools/treecheck.mjs",
    "sitecheck": "node tools/sitecheck.mjs",
    "smoke": "node tools/smoke.mjs",
    "trade": "node tools/trade.mjs",
    "nebula": "node tools/nebula.mjs",
    "aliens": "node tools/aliens.mjs",
    "ground": "node tools/ground.mjs",
    "living": "node tools/living.mjs",
    "mystery": "node tools/mystery.mjs",
    "expedition": "node tools/expedition.mjs",
    "lang": "node tools/lang.mjs",
    "judge": "node tools/judgeset.mjs",
    "reprocheck": "node tools/reprocheck.mjs",
    "splash": "node tools/splash.mjs --pose --out public/og.png && sips -z 630 1200 --setProperty format jpeg --setProperty formatOptions 88 public/og.png --out public/og.jpg >/dev/null && rm public/og.png",
    "icons": "node tools/icons.mjs",
    "deploy": "vite build && npx wrangler deploy"
  },
  "keywords": [
    "webgl2",
    "three.js",
    "procedural-generation",
    "glsl",
    "space",
    "game"
  ],
  "author": "Star Universe contributors",
  "contributors": [
    "Anshu Chimala (original engine: The Long Silence)"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "vite": "^8.1.5"
  },
  "private": true
}
